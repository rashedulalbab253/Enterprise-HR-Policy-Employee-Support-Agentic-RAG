# Groq LLM (Free at https://console.groq.com/ - e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Local HuggingFace Embeddings (Free, runs locally on CPU - e.g. bge-small-en-v1.5, all-MiniLM-L6-v2)
EMBEDDING_MODEL=bge-small-en-v1.5


# Web Search & Vector Store
TAVILY_API_KEY=your_tavily_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-hr-policy-rag
PINECONE_NAMESPACE=company-hr-kb
ADMIN_API_KEY=change-me-in-production
APP_ENV=development
PORT=8000

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=enterprise-hr-policy-rag
